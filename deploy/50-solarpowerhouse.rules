// Allow only the dedicated HMI user to control only the Solar Powerhouse core unit.
polkit.addRule(function(action, subject) {
    var allowedVerbs = ["start", "stop", "restart"];
    if (subject.user == "solarpowerhouse"
        && action.id == "org.freedesktop.systemd1.manage-units"
        && action.lookup("unit") == "solar-core.service"
        && allowedVerbs.indexOf(action.lookup("verb")) >= 0) {
        return polkit.Result.YES;
    }
});
